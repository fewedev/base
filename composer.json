{
    "name": "fewedev/base",
    "description": "Feasible web development base classes",
    "license": "MIT",
    "keywords": [
        "base"
    ],
    "homepage": "https://github.com/fewedev/base",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.3",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "FeWeDev\\Base\\": "src"
        },
        "classmap": [
            "src/"
        ]
    },
    "scripts": {
        "fix": "vendor/bin/php-cs-fixer fix src",
        "cs": "vendor/bin/php-cs-fixer fix src --dry-run --verbose --diff",
        "ps": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit tests"
    }
}
